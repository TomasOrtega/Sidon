import Sidon.Analysis.FourierIntegral
import Mathlib.MeasureTheory.Integral.Pi

/-! # Fourier analysis on finite products of the unit circle

The character-density and Hilbert-basis arguments adapt mathlib's later
`Mathlib.Analysis.Fourier.AddCircleMulti` to the project's pinned version.
-/

noncomputable section

open scoped ComplexConjugate ENNReal
open Set Algebra Submodule MeasureTheory

namespace Sidon

abbrev torusHaar (d : ℕ) : Measure (Fin d → AddCircle (1 : ℝ)) :=
  Measure.pi (fun _ => circleHaar)

local instance : MeasureSpace (AddCircle (1 : ℝ)) := ⟨circleHaar⟩
local instance : Measure.IsAddHaarMeasure (volume : Measure (AddCircle (1 : ℝ))) :=
  inferInstanceAs (Measure.IsAddHaarMeasure circleHaar)
local instance : IsProbabilityMeasure (volume : Measure (AddCircle (1 : ℝ))) :=
  inferInstanceAs (IsProbabilityMeasure circleHaar)

variable {d : ℕ}

/-- An integer-frequency character on a finite product of circles. -/
def torusCharacter (n : Fin d → ℤ) : C(Fin d → AddCircle (1 : ℝ), ℂ) where
  toFun x := ∏ i : Fin d, fourier (n i) (x i)
  continuous_toFun := by fun_prop

@[simp] theorem torusCharacter_apply (n : Fin d → ℤ) (x : Fin d → AddCircle (1 : ℝ)) :
    torusCharacter n x = ∏ i, fourier (n i) (x i) := rfl

theorem torusCharacter_neg (n : Fin d → ℤ) (x : Fin d → AddCircle (1 : ℝ)) :
    torusCharacter (-n) x = conj (torusCharacter n x) := by
  simp only [torusCharacter_apply, Pi.neg_apply, fourier_neg, map_prod]

theorem torusCharacter_add (m n : Fin d → ℤ) (x : Fin d → AddCircle (1 : ℝ)) :
    torusCharacter (m + n) x = torusCharacter m x * torusCharacter n x := by
  simp only [torusCharacter_apply, Pi.add_apply, fourier_add, Finset.prod_mul_distrib]

@[simp] theorem torusCharacter_zero : torusCharacter (0 : Fin d → ℤ) = 1 := by
  ext x
  simp only [torusCharacter_apply, Pi.zero_apply, fourier_zero, Finset.prod_const_one,
    ContinuousMap.one_apply]

theorem norm_torusCharacter_apply (n : Fin d → ℤ) (x : Fin d → AddCircle (1 : ℝ)) :
    ‖torusCharacter n x‖ = 1 := by
  rw [torusCharacter_apply, norm_prod]
  exact Finset.prod_eq_one fun i _ => Circle.abs_coe _

theorem norm_torusCharacter (n : Fin d → ℤ) : ‖torusCharacter n‖ = 1 := by
  apply le_antisymm
  · exact (ContinuousMap.norm_le _ zero_le_one).mpr fun x => (norm_torusCharacter_apply n x).le
  · calc
      1 = ‖torusCharacter n 0‖ := (norm_torusCharacter_apply n 0).symm
      _ ≤ ‖torusCharacter n‖ := (torusCharacter n).norm_coe_le_norm 0

theorem torusCharacter_single (x : Fin d → AddCircle (1 : ℝ)) (i : Fin d) :
    torusCharacter (Pi.single i 1) x = fourier 1 (x i) := by
  classical
  rw [torusCharacter_apply, Finset.prod_eq_single i]
  · rw [Pi.single_eq_same]
  · intro j _ hji
    simp only [Pi.single_eq_of_ne hji, fourier_zero]
  · simp

/-- The star algebra generated by the torus characters. -/
def torusCharacterAlgebra (d : ℕ) : StarSubalgebra ℂ C(Fin d → AddCircle (1 : ℝ), ℂ) where
  toSubalgebra := Algebra.adjoin ℂ (range torusCharacter)
  star_mem' := by
    change Algebra.adjoin ℂ (range torusCharacter) ≤ star (Algebra.adjoin ℂ (range torusCharacter))
    refine adjoin_le ?_
    rintro _ ⟨n, rfl⟩
    refine subset_adjoin ⟨-n, ?_⟩
    ext x
    simp only [torusCharacter_neg, starRingEnd_apply, ContinuousMap.star_apply]

theorem torusCharacterAlgebra_coe :
    (torusCharacterAlgebra d).toSubalgebra.toSubmodule = span ℂ (range torusCharacter) := by
  apply adjoin_eq_span_of_subset
  refine Subset.trans ?_ Submodule.subset_span
  intro x hx
  refine Submonoid.closure_induction (fun _ => id) ⟨0, ?_⟩ ?_ hx
  · exact torusCharacter_zero
  · rintro _ _ _ _ ⟨m, rfl⟩ ⟨n, rfl⟩
    refine ⟨m + n, ?_⟩
    ext z
    exact torusCharacter_add m n z

theorem torusCharacterAlgebra_separatesPoints : (torusCharacterAlgebra d).SeparatesPoints := by
  classical
  intro x y hxy
  obtain ⟨i, hi⟩ := Function.ne_iff.mp hxy
  refine ⟨_, ⟨torusCharacter (Pi.single i 1), subset_adjoin ⟨Pi.single i 1, rfl⟩, rfl⟩, ?_⟩
  dsimp only
  rw [torusCharacter_single, torusCharacter_single, fourier_one, fourier_one]
  intro h
  rw [Subtype.coe_inj] at h
  exact hi (AddCircle.injective_toCircle one_ne_zero h)

theorem span_torusCharacter_closure_eq_top :
    (span ℂ (range (torusCharacter (d := d)))).topologicalClosure = ⊤ := by
  rw [← torusCharacterAlgebra_coe]
  exact congr_arg (Subalgebra.toSubmodule <| StarSubalgebra.toSubalgebra ·)
    (ContinuousMap.starSubalgebra_topologicalClosure_eq_top_of_separatesPoints _
      torusCharacterAlgebra_separatesPoints)

abbrev torusCharacterLp (p : ℝ≥0∞) [Fact (1 ≤ p)] (n : Fin d → ℤ) :
    Lp ℂ p (torusHaar d) :=
  ContinuousMap.toLp (E := ℂ) p (torusHaar d) ℂ (torusCharacter n)

theorem coeFn_torusCharacterLp (p : ℝ≥0∞) [Fact (1 ≤ p)] (n : Fin d → ℤ) :
    torusCharacterLp p n =ᵐ[torusHaar d] torusCharacter n :=
  ContinuousMap.coeFn_toLp (torusHaar d) (torusCharacter n)

theorem span_torusCharacterLp_closure_eq_top {p : ℝ≥0∞} [Fact (1 ≤ p)] (hp : p ≠ ∞) :
    (span ℂ (range (@torusCharacterLp d p _))).topologicalClosure = ⊤ := by
  simpa only [map_span, ContinuousLinearMap.coe_coe, ← range_comp, Function.comp_def] using
    (ContinuousMap.toLp_denseRange ℂ (torusHaar d) ℂ hp).topologicalClosure_map_submodule
      span_torusCharacter_closure_eq_top

theorem orthonormal_torusCharacter : Orthonormal ℂ (torusCharacterLp (d := d) 2) := by
  rw [orthonormal_iff_ite]
  intro m n
  rw [ContinuousMap.inner_toLp]
  simp only [← torusCharacter_neg, ← torusCharacter_add]
  split_ifs with h
  · simp only [h, neg_add_cancel, torusCharacter_zero, ContinuousMap.one_apply]
    simp
  · change (∫ x : Fin d → AddCircle (1 : ℝ),
      ∏ i, fourier ((-m + n) i) (x i)) = 0
    rw [MeasureTheory.integral_fintype_prod_eq_prod]
    obtain ⟨i, hi⟩ := Function.ne_iff.mp h
    apply Finset.prod_eq_zero (Finset.mem_univ i)
    simp only [Pi.add_apply, Pi.neg_apply]
    change (∫ x : AddCircle (1 : ℝ), fourier (-m i + n i) x ∂circleHaar) = 0
    rw [integral_fourier, if_neg]
    omega

/-- The Fourier coefficient for probability Haar measure on the torus. -/
def torusFourierCoeff (f : (Fin d → AddCircle (1 : ℝ)) → ℂ) (n : Fin d → ℤ) : ℂ :=
  ∫ x, torusCharacter (-n) x * f x ∂torusHaar d

/-- The complete orthonormal character basis of the torus. -/
def torusFourierBasis : HilbertBasis (Fin d → ℤ) ℂ (Lp ℂ 2 (torusHaar d)) :=
  HilbertBasis.mk orthonormal_torusCharacter (span_torusCharacterLp_closure_eq_top (by simp)).ge

@[simp] theorem coe_torusFourierBasis :
    ⇑(torusFourierBasis (d := d)) = torusCharacterLp 2 := HilbertBasis.coe_mk _ _

theorem torusFourierBasis_repr (f : Lp ℂ 2 (torusHaar d)) (n : Fin d → ℤ) :
    torusFourierBasis.repr f n = torusFourierCoeff f n := by
  trans ∫ x, conj (torusCharacterLp 2 n x) * f x ∂torusHaar d
  · rw [torusFourierBasis.repr_apply_apply f n, MeasureTheory.L2.inner_def,
      coe_torusFourierBasis]
    simp only [RCLike.inner_apply]
  · apply integral_congr_ae
    filter_upwards [coeFn_torusCharacterLp 2 n] with x hx
    rw [hx, ← torusCharacter_neg]

theorem hasSum_torusFourier_series_L2 (f : Lp ℂ 2 (torusHaar d)) :
    HasSum (fun n => torusFourierCoeff f n • torusCharacterLp 2 n) f := by
  simp_rw [← torusFourierBasis_repr]
  rw [← coe_torusFourierBasis]
  exact HilbertBasis.hasSum_repr torusFourierBasis f

theorem torusFourierCoeff_toLp (f : C(Fin d → AddCircle (1 : ℝ), ℂ)) (n : Fin d → ℤ) :
    torusFourierCoeff (ContinuousMap.toLp (E := ℂ) 2 (torusHaar d) ℂ f) n =
      torusFourierCoeff f n :=
  integral_congr_ae (ae_eq_rfl.mul (ContinuousMap.coeFn_toAEEqFun (torusHaar d) f))

theorem hasSum_torusFourier_series_of_summable {f : C(Fin d → AddCircle (1 : ℝ), ℂ)}
    (h : Summable (torusFourierCoeff f)) :
    HasSum (fun n => torusFourierCoeff f n • torusCharacter n) f := by
  have hL2 := hasSum_torusFourier_series_L2 (ContinuousMap.toLp (E := ℂ) 2 (torusHaar d) ℂ f)
  simp only [torusFourierCoeff_toLp] at hL2
  refine ContinuousMap.hasSum_of_hasSum_Lp (.of_norm ?_) hL2
  convert h.norm using 1
  ext n
  exact (norm_smul (torusFourierCoeff f n) (torusCharacter n)).trans
    (by rw [norm_torusCharacter, mul_one])

theorem hasSum_torusFourier_series_apply_of_summable {f : C(Fin d → AddCircle (1 : ℝ), ℂ)}
    (h : Summable (torusFourierCoeff f)) (x : Fin d → AddCircle (1 : ℝ)) :
    HasSum (fun n => torusFourierCoeff f n * torusCharacter n x) (f x) := by
  simpa only [smul_eq_mul] using
    (ContinuousMap.evalCLM ℂ x).hasSum (hasSum_torusFourier_series_of_summable h)

theorem hasSum_prod_torusFourierCoeff (f g : Lp ℂ 2 (torusHaar d)) :
    HasSum (fun n => conj (torusFourierCoeff f n) * torusFourierCoeff g n)
      (∫ x, conj (f x) * g x ∂torusHaar d) := by
  have h := torusFourierBasis.hasSum_inner_mul_inner f g
  rw [L2.inner_def] at h
  simp only [RCLike.inner_apply] at h
  convert h using 1
  ext n
  rw [← torusFourierBasis_repr, ← torusFourierBasis_repr,
    HilbertBasis.repr_apply_apply, HilbertBasis.repr_apply_apply, inner_conj_symm]

theorem hasSum_sq_torusFourierCoeff (f : Lp ℂ 2 (torusHaar d)) :
    HasSum (fun n => ‖torusFourierCoeff f n‖ ^ 2)
      (∫ x, ‖f x‖ ^ 2 ∂torusHaar d) := by
  have h := RCLike.hasSum_re ℂ (hasSum_prod_torusFourierCoeff f f)
  have hi : Integrable (fun x => conj (f x) * f x) (torusHaar d) := by
    simpa only [RCLike.inner_apply] using L2.integrable_inner f f
  rw [← integral_re hi] at h
  simpa only [Complex.conj_mul', ← Complex.ofReal_pow, Complex.ofReal_re] using h


end Sidon
