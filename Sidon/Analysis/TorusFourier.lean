public import Sidon.Analysis.FourierIntegral
public import Mathlib.Analysis.Fourier.AddCircleMulti

@[expose] public section

/-! # Probability-normalized Fourier analysis on the finite torus -/

noncomputable section

open scoped ComplexConjugate ENNReal
open Set Algebra Submodule MeasureTheory

namespace Sidon

abbrev torusHaar (d : ℕ) : Measure (Fin d → AddCircle (1 : ℝ)) :=
  Measure.pi (fun _ => circleHaar)

local instance : MeasureSpace (AddCircle (1 : ℝ)) := ⟨circleHaar⟩
local instance : Measure.IsAddHaarMeasure (volume : Measure (AddCircle (1 : ℝ))) :=
  inferInstanceAs (Measure.IsAddHaarMeasure circleHaar)
local instance : IsProbabilityMeasure (volume : Measure (AddCircle (1 : ℝ))) :=
  inferInstanceAs (IsProbabilityMeasure circleHaar)

variable {d : ℕ}

/-- An integer-frequency character on a finite product of circles. -/
def torusCharacter (n : Fin d → ℤ) : C(Fin d → AddCircle (1 : ℝ), ℂ) :=
  UnitAddTorus.mFourier n

@[simp] theorem torusCharacter_apply (n : Fin d → ℤ) (x : Fin d → AddCircle (1 : ℝ)) :
    torusCharacter n x = ∏ i, fourier (n i) (x i) := rfl

theorem torusCharacter_neg (n : Fin d → ℤ) (x : Fin d → AddCircle (1 : ℝ)) :
    torusCharacter (-n) x = conj (torusCharacter n x) :=
  UnitAddTorus.mFourier_neg

theorem torusCharacter_add (m n : Fin d → ℤ) (x : Fin d → AddCircle (1 : ℝ)) :
    torusCharacter (m + n) x = torusCharacter m x * torusCharacter n x :=
  UnitAddTorus.mFourier_add

@[simp] theorem torusCharacter_zero : torusCharacter (0 : Fin d → ℤ) = 1 :=
  UnitAddTorus.mFourier_zero

theorem norm_torusCharacter_apply (n : Fin d → ℤ) (x : Fin d → AddCircle (1 : ℝ)) :
    ‖torusCharacter n x‖ = 1 := by
  simp only [torusCharacter_apply, norm_prod, fourier_apply, Circle.norm_coe,
    Finset.prod_const_one]

theorem norm_torusCharacter (n : Fin d → ℤ) : ‖torusCharacter n‖ = 1 :=
  UnitAddTorus.mFourier_norm

theorem torusCharacter_single (x : Fin d → AddCircle (1 : ℝ)) (i : Fin d) :
    torusCharacter (Pi.single i 1) x = fourier 1 (x i) :=
  UnitAddTorus.mFourier_single x i

/-- The star algebra generated by the torus characters. -/
def torusCharacterAlgebra (d : ℕ) : StarSubalgebra ℂ C(Fin d → AddCircle (1 : ℝ), ℂ) :=
  UnitAddTorus.mFourierSubalgebra (Fin d)

theorem torusCharacterAlgebra_coe :
    (torusCharacterAlgebra d).toSubalgebra.toSubmodule = span ℂ (range torusCharacter) :=
  UnitAddTorus.mFourierSubalgebra_coe

theorem torusCharacterAlgebra_separatesPoints : (torusCharacterAlgebra d).SeparatesPoints :=
  UnitAddTorus.mFourierSubalgebra_separatesPoints

theorem span_torusCharacter_closure_eq_top :
    (span ℂ (range (torusCharacter (d := d)))).topologicalClosure = ⊤ :=
  UnitAddTorus.span_mFourier_closure_eq_top

abbrev torusCharacterLp (p : ℝ≥0∞) [Fact (1 ≤ p)] (n : Fin d → ℤ) :
    Lp ℂ p (torusHaar d) :=
  ContinuousMap.toLp (E := ℂ) p (torusHaar d) ℂ (torusCharacter n)

theorem coeFn_torusCharacterLp (p : ℝ≥0∞) [Fact (1 ≤ p)] (n : Fin d → ℤ) :
    torusCharacterLp p n =ᵐ[torusHaar d] torusCharacter n :=
  UnitAddTorus.coeFn_mFourierLp p n

theorem span_torusCharacterLp_closure_eq_top {p : ℝ≥0∞} [Fact (1 ≤ p)] (hp : p ≠ ∞) :
    (span ℂ (range (@torusCharacterLp d p _))).topologicalClosure = ⊤ :=
  UnitAddTorus.span_mFourierLp_closure_eq_top hp

theorem orthonormal_torusCharacter : Orthonormal ℂ (torusCharacterLp (d := d) 2) :=
  UnitAddTorus.orthonormal_mFourier

/-- The Fourier coefficient for probability Haar measure on the torus. -/
def torusFourierCoeff (f : (Fin d → AddCircle (1 : ℝ)) → ℂ) (n : Fin d → ℤ) : ℂ :=
  ∫ x, torusCharacter (-n) x * f x ∂torusHaar d

/-- The complete orthonormal character basis of the torus. -/
def torusFourierBasis : HilbertBasis (Fin d → ℤ) ℂ (Lp ℂ 2 (torusHaar d)) :=
  UnitAddTorus.mFourierBasis

@[simp] theorem coe_torusFourierBasis :
    ⇑(torusFourierBasis (d := d)) = torusCharacterLp 2 :=
  UnitAddTorus.coe_mFourierBasis

theorem torusFourierBasis_repr (f : Lp ℂ 2 (torusHaar d)) (n : Fin d → ℤ) :
    torusFourierBasis.repr f n = torusFourierCoeff f n :=
  UnitAddTorus.mFourierBasis_repr f n

theorem hasSum_torusFourier_series_L2 (f : Lp ℂ 2 (torusHaar d)) :
    HasSum (fun n => torusFourierCoeff f n • torusCharacterLp 2 n) f :=
  UnitAddTorus.hasSum_mFourier_series_L2 f

theorem torusFourierCoeff_toLp (f : C(Fin d → AddCircle (1 : ℝ), ℂ)) (n : Fin d → ℤ) :
    torusFourierCoeff (ContinuousMap.toLp (E := ℂ) 2 (torusHaar d) ℂ f) n =
      torusFourierCoeff f n :=
  UnitAddTorus.mFourierCoeff_toLp f n

theorem hasSum_torusFourier_series_of_summable {f : C(Fin d → AddCircle (1 : ℝ), ℂ)}
    (h : Summable (torusFourierCoeff f)) :
    HasSum (fun n => torusFourierCoeff f n • torusCharacter n) f :=
  UnitAddTorus.hasSum_mFourier_series_of_summable h

theorem hasSum_torusFourier_series_apply_of_summable {f : C(Fin d → AddCircle (1 : ℝ), ℂ)}
    (h : Summable (torusFourierCoeff f)) (x : Fin d → AddCircle (1 : ℝ)) :
    HasSum (fun n => torusFourierCoeff f n * torusCharacter n x) (f x) := by
  have hs : HasSum (fun n => torusFourierCoeff f n • torusCharacter n x) (f x) :=
    UnitAddTorus.hasSum_mFourier_series_apply_of_summable h x
  simpa only [smul_eq_mul] using hs

theorem hasSum_prod_torusFourierCoeff (f g : Lp ℂ 2 (torusHaar d)) :
    HasSum (fun n => conj (torusFourierCoeff f n) * torusFourierCoeff g n)
      (∫ x, conj (f x) * g x ∂torusHaar d) :=
  UnitAddTorus.hasSum_prod_mFourierCoeff f g

theorem hasSum_sq_torusFourierCoeff (f : Lp ℂ 2 (torusHaar d)) :
    HasSum (fun n => ‖torusFourierCoeff f n‖ ^ 2)
      (∫ x, ‖f x‖ ^ 2 ∂torusHaar d) :=
  UnitAddTorus.hasSum_sq_mFourierCoeff f

end Sidon
